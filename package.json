{
  "name": "nextdcp",
  "version": "0.8.0",
  "description": "Bounded task-focused working memory and archived recall for OpenCode V2",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts src/tui.ts --bundle --platform=node --format=esm --target=es2023 --external:@opencode/plugin --external:@opencode/plugin/tui --outdir=dist",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/",
    "prerelease:local": "npm run typecheck && npm test",
    "release:local": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robindubreuil/nextdcp.git"
  },
  "homepage": "https://github.com/robindubreuil/nextdcp#readme",
  "bugs": {
    "url": "https://github.com/robindubreuil/nextdcp/issues"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.5 <3"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.5",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
